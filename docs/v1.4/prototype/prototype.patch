+
+/** PROTOTYPE ONLY (#295): sail look variants from ?look=A|B|C. */
+function protoSail(level: number, i: number, j: number, nu: number, nv: number, band: string) {
+  const look = new URLSearchParams(location.search).get('look');
+  if (!look || level === 1) return undefined;
+  const edge = i === 0 || i === nu - 1 || j === 0 || j === nv - 1;
+  const mid = j === nv / 2 - 1 || j === nv / 2;
+  if (look === 'A') {
+    if (level === 2) return edge ? '#c9b78c' : (i % 2 ? '#f1ead9' : '#e6dcc3');
+    return edge ? band : mid ? band : '#f4efe2';
+  }
+  if (look === 'B') {
+    if (level === 2) return j === 0 ? band : '#eee6d4';
+    return j === 0 || j === nv - 1 || mid ? band : '#f4efe2';
+  }
+  if (level === 2) return i % 2 ? '#f1ead9' : '#ddd2b6';
+  return i === 0 ? band : j % 2 ? '#f4efe2' : '#dfd5ba';
+}
