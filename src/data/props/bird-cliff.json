      "color": { "pick": "i % 2", "of": ["#f4f2ee", "#e9e6dc"] }
    },
    {
      "repeat": { "i": { "count": 2 }, "side": [-1, 1] },
      "box": [1.3, 0.08, 0.3],
      "ops": [
        ["move", 0.6, 0, 0],
        ["turnZ", 0.35],
        ["turnY", "side > 0 ? 0 : pi"],
        ["move", "-1 + i * 2", "3.2 + i * 1.4", "2.8 + i * 0.8"]
      ],
      "color": "#f4f2ee"
    }
  ]
}
