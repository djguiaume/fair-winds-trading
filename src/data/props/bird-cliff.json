{
  "id": "bird-cliff",
  "name": "Bird cliff",
  "group": "landmarks",
  "sizedInModel": true,
  "scale": "size",
  "parts": [
    {
      "repeat": { "i": { "count": 4 } },
      "box": [0.5, 0.42, 0.62],
      "ops": [
        ["turnY", "i * 1.3"],
        ["move", "-1.5 + i * 1", 0.21, "0.9 + cos(i * 1.7) * 0.4"]
