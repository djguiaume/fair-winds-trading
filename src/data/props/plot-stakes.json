{
  "id": "plot-stakes",
  "name": "Staked plot",
  "group": "town",
  "fit": 1,
  "vars": {
    "h": 0.9,
    "s": 0.95,
    "sy": 1.15,
    "open": 1,
    "d": "variant % 6 + 1"
  },
  "parts": [
    {
      "repeat": {
        "k": {
          "count": 4
        }
      },
      "parts": [
        {
          "cyl": [0.07, 0.08, "h", 4, 1],
          "at": ["s * (k % 2 * 2 - 1)", "h / 2", "s * (floor(k / 2) * 2 - 1)"],
          "color": "post"
        },
        {
          "if": "open",
          "plane": [0.46, 0.22],
          "at": ["s * (k % 2 * 2 - 1) + 0.23", "h - 0.1", "s * (floor(k / 2) * 2 - 1) + 0.01"],
          "color": "flag"
        }
      ]
    },
    {
      "if": "open",
      "parts": [
        {
          "cyl": [0.06, 0.08, 3, 4, 1],
          "at": ["-s", 1.5, "s"],
          "color": "post"
        },
        {
          "box": [1.1, 0.5, 0.04],
          "at": ["0.55 - s", 2.7, "s"],
          "color": "flag"
        }
      ]
    },
    {
      "plane": ["2 * s", 0.04],
      "ops": [["turnX", "-pi / 2"]],
      "at": [0, "h * 0.7", "-s"],
      "color": "cream"
    },
    {
      "plane": ["2 * s", 0.04],
      "ops": [["turnX", "-pi / 2"]],
      "at": [0, "h * 0.7", "s"],
      "color": "cream"
    },
    {
      "plane": [0.04, "2 * s"],
      "ops": [["turnX", "-pi / 2"]],
      "at": ["-s", "h * 0.7", 0],
      "color": "cream"
    },
    {
      "plane": [0.04, "2 * s"],
      "ops": [["turnX", "-pi / 2"]],
      "at": ["s", "h * 0.7", 0],
      "color": "cream"
    },
    {
      "if": "open",
      "parts": [
        {
          "cyl": [0.05, 0.05, 1.25, 4, 1],
          "at": [0, 0.62, "s + 0.25"],
          "color": "post"
        },
        {
          "box": [0.9, 0.66, 0.06],
          "at": [0, "sy", "s + 0.29"],
          "color": "plank"
        },
        {
          "if": "d == 2 || d == 3 || d == 5 || d == 6",
          "plane": [0.24, 0.07],
          "at": [0, "sy + 0.195", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d >= 2",
          "plane": [0.24, 0.07],
          "at": [0, "sy", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d == 2 || d == 3 || d == 5 || d == 6",
          "plane": [0.24, 0.07],
          "at": [0, "sy - 0.195", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d <= 4",
          "plane": [0.07, 0.22],
          "at": [0.1, "sy + 0.1", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d != 2",
          "plane": [0.07, 0.22],
          "at": [0.1, "sy - 0.1", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d == 2 || d == 6",
          "plane": [0.07, 0.22],
          "at": [-0.1, "sy - 0.1", "s + 0.33"],
          "color": "post"
        },
        {
          "if": "d >= 4",
          "plane": [0.07, 0.22],
          "at": [-0.1, "sy + 0.1", "s + 0.33"],
          "color": "post"
        }
      ]
    }
  ]
}
