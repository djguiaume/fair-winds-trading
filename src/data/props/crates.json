{
  "id": "crates",
  "group": "town",
  "vars": {
    "n": "variant == 0 ? 2 : variant"
  },
  "parts": [
    {
      "repeat": {
        "i": {
          "count": "n"
        }
      },
      "parts": [
        {
          "if": "i % 3 == 2",
          "cyl": [0.22, 0.22, 0.5],
          "at": ["i % 3 * 0.5 - 0.5", "(i >= 3 ? 0.45 : 0) + 0.25", 0],
          "color": "#8a5a32"
        },
        {
          "if": "i % 3 != 2",
          "box": [0.45, 0.45, 0.45],
          "at": ["i % 3 * 0.5 - 0.5", "(i >= 3 ? 0.45 : 0) + 0.22", 0],
          "color": "plank"
        }
      ]
    }
  ]
}
