{
  "name": "fair-winds-trading",
  "private": true,
  "version": "0.4.0",
  "description": "Browser sailing and trading game (three.js + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "node tools/performance/run.mjs",
    "perf:test": "node --test tools/performance/stats.test.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fw": "node tools/fw/fw.mjs",
    "check": "node tools/fw/fw.mjs check",
    "balance": "node tools/fw/fw.mjs balance",
    "island": "node tools/fw/fw.mjs island",
    "adr": "node tools/fw/fw.mjs adr",
    "shots": "node tools/fw/fw.mjs shots",
    "quest": "node tools/fw/fw.mjs quest",
    "chart": "node tools/fw/fw.mjs chart"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "three": "^0.186.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
